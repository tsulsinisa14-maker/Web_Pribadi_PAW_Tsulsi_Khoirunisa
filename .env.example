# Salin file ini menjadi ".env" lalu isi sesuai kebutuhan.
# File ".env" TIDAK boleh di-commit (sudah ada di .gitignore).

# --- Non-rahasia: boleh tampil di website (wajib berawalan VITE_) ---
VITE_APP_NAME=Daftar Tugas Kuliah
VITE_APP_VERSION=1.0.0
VITE_APP_AUTHOR=Tsulsi Khoirunisa

# --- Rahasia: TANPA awalan VITE_ supaya tidak masuk ke browser ---
# Contoh saja, isi dengan nilai asli hanya di file .env lokal.
SECRET_API_KEY=isi_di_file_env_lokal	